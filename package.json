{
  "name": "mc-alts-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that shows a Minecraft server tab list and keeps alt accounts online 24/7",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "ping": "node scripts/ping.js",
    "test-join": "node scripts/test-join.js"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "mineflayer": "^4.39.0",
    "minecraft-protocol": "^1.68.0"
  }
}
