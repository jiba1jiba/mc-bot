# ============================================================
#  Discord
# ============================================================
# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# ID приложения (нужен только для ручного `npm run deploy`; для авто-регистрации не обязателен)
DISCORD_CLIENT_ID=

# ID вашего Discord-сервера (ПКМ по серверу -> Копировать ID, нужен Developer Mode).
# Если указать — слеш-команды появятся сразу. Если пусто — глобально (до 1 часа).
DISCORD_GUILD_ID=

# Кто может пользоваться командами.
# По умолчанию — только те, у кого есть право "Управление сервером" (Manage Server).
# Можно ограничить конкретными ролями/юзерами (через запятую):
ADMIN_ROLE_ID=
ADMIN_USER_IDS=

# true — разрешить команды всем участникам сервера (не рекомендуется)
ALLOW_EVERYONE=false

# ============================================================
#  Minecraft-сервер
# ============================================================
MC_HOST=5.83.140.250
MC_PORT=25588

# Версия клиента.
# auto — определить автоматически по ответу сервера (рекомендуется).
# Можно зафиксировать вручную, например 26.1.2 или 1.21.4.
MC_VERSION=auto

# offline — для пиратских/offline-mode серверов (любой ник без пароля).
# microsoft — для premium (потребуется вход в аккаунт Microsoft, не поддерживается "из коробки").
MC_AUTH=offline

# true — автоматически поднимать всех сохранённых ботов при старте процесса (после ребута VPS)
AUTO_JOIN=false

# ============================================================
#  Поведение ботов
# ============================================================
# Автоматически переподключаться при кике/обрыве
RECONNECT=true
# 0 = бесконечно
MAX_RECONNECTS=0
# Базовая задержка переподключения (мс), дальше растёт экспоненциально
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
# Пауза между запуском нескольких ботов, чтобы не спамить сервер (мс)
JOIN_DELAY_MS=1500
# Дальность прорисовки бота (tiny = минимум ресурсов)
MC_VIEW_DISTANCE=tiny
# Физика бота (false = меньше CPU, бот просто стоит в мире)
MC_PHYSICS=false

# ============================================================
#  Прочее
# ============================================================
# Куда сохранять список аккаунтов
DATA_DIR=data

# Начальный список ников. Используется, только если data/accounts.json ещё нет
# (и на хостингах без постоянного диска — при каждом старте).
ACCOUNTS=serphut,serphut1,serphut2,serphut3
